; alu.s2 -- integer and float ALU on sm_80, out of one 32-bit input per thread:
;   oi[i] = (y = rotl(x ^ 0x5a5a5a5a, 7) * 0x9e3779b1 + i) > 0x80000000 ? y : x
;   of[i] = (unsigned)(((float)(x & 0xffff) * 0.5f + 3.0f) squared)        x = a[i], i < n
; Parameters: a 0x160, oi 0x168, of 0x170, n 0x178 (cubin signature pppu).
; Written by hand in asm2's language with the names of sm80.tbl, CUDA ABI constant bank
; (c[0x0][0x0] blockDim.x, 0x28 stack top, parameters from 0x160): the layout NVIDIA's driver fills
; when the kernel is loaded through cuModuleLoadData (seed/sm80/cubin.om writes the matching .nv.info).
; Schedule, conservative on purpose: every fixed-latency instruction stalls 15 cycles; every
; variable-latency one (NAK's has_fixed_latency, `NAKREF_LAT=1 nakref listing`) sets a scoreboard
; and the next instruction that needs anything waits on all six (mask 63). A scoreboard is armed
; 2 cycles after the instruction that sets it issues (Mesa NAK calc_instr_deps.rs, `bars[bar] + 2`),
; so a setter whose next instruction waits stalls 2, not 1: instructions 4 and 10 stalled 1, the
; wait at 11 could miss scoreboard 2 and IMAD.WIDE at 14 read a stale R6 (wrong words or an address
; fault on an RTX 4090). cubin.om refuses such a listing with exit 7.
; Referee: `nakref listing 80 <this> <out>` must give the same bytes as asm2 + sm80.tbl.
;  0 LDC R1, c[0x0][0x28]   stack top (CUDA ABI)
  ldc.0 7 1 255
  cb.1 0x28 0
  ldc.2 4 0
  c 1 1 7 7 0 0
;  1 S2R R9, SR_CTAID.X
  s2r.0 7 9
  z.1
  s2r.2 0x25
  c 1 1 0 7 0 0
;  2 ULDC UR4, c[0x0][0x0]   blockDim.x
  uldc.0 7 4
  cb.1 0x0 0
  uldc.2 4
  c 1 1 1 7 0 0
;  3 S2R R0, SR_TID.X
  s2r.0 7 0
  z.1
  s2r.2 0x21
  c 1 1 2 7 0 0
;  4 ULDC UR5, c[0x0][0x178]   n
  uldc.0 7 5
  cb.1 0x178 0
  uldc.2 4
  c 2 1 3 7 0 0
;  5 IMAD R9, R9, UR4, R0   i = block * blockDim + thread
  imad.u.0 7 9 9
  u.1 4
  imad.u.2 0 0
  c 15 0 7 7 63 0
;  6 ISETP.GE.U32.AND P0, PT, R9, UR5, PT
  isetp.u.0 7 9
  u.1 5
  isetp.u.2 7 0 0 0 6 0 7
  c 15 0 7 7 0 0
;  7 @P0 EXIT
  exit.0 0
  z.1
  exit.2
  c 5 1 7 7 0 0
;  8 LDC.64 R2, c[0x0][0x160]   first pointer
  ldc.0 7 2 255
  cb.1 0x160 0
  ldc.2 5 0
  c 1 1 0 7 0 0
;  9 LDC.64 R4, c[0x0][0x168]   second pointer
  ldc.0 7 4 255
  cb.1 0x168 0
  ldc.2 5 0
  c 1 1 1 7 0 0
; 10 LDC.64 R6, c[0x0][0x170]   third pointer
  ldc.0 7 6 255
  cb.1 0x170 0
  ldc.2 5 0
  c 2 1 2 7 0 0
; 11 IMAD.WIDE.U32 R2, R9, 0x4, R2
  imadw.i.0 7 2 9
  n.1 4
  imad.2 2 0
  c 15 0 7 7 63 0
; 12 LDG.E R10, [R2.64]
  ldg.0 7 10 2
  ldg.1 63 0
  ldg.2 0 1 4 7 1 1
  c 2 1 3 7 0 0
; 13 IMAD.WIDE.U32 R4, R9, 0x4, R4
  imadw.i.0 7 4 9
  n.1 4
  imad.2 4 0
  c 15 0 7 7 0 0
; 14 IMAD.WIDE.U32 R6, R9, 0x4, R6
  imadw.i.0 7 6 9
  n.1 4
  imad.2 6 0
  c 15 0 7 7 0 0
; 15 LOP3.LUT R11, R10, 0x5a5a5a5a, RZ, 0x3c   y = x ^ 0x5a5a5a5a
  lop3.i.0 7 11 10
  n.1 0x5a5a5a5a
  lop3.2 255 0x3c
  c 15 0 7 7 63 0
; 16 SHF.L.W.U32.HI R11, R11, 0x7, R11   y = rotl(y, 7)
  shf.i.0 7 11 11
  n.1 7
  shf.2 11 3 1 0 1
  c 15 0 7 7 0 0
; 17 IMAD R11, R11, 0x9e3779b1, R9   y = y * 0x9e3779b1 + i
  imad.i.0 7 11 11
  n.1 0x9e3779b1
  imad.2 9 0
  c 15 0 7 7 0 0
; 18 ISETP.GT.U32.AND P0, PT, R11, 0x80000000, PT
  isetp.i.0 7 11
  n.1 0x80000000
  isetp.2 7 0 0 0 4 0 7
  c 15 0 7 7 0 0
; 19 SEL R12, R11, R10, P0   z = y > 0x80000000 ? y : x
  sel.0 7 12 11
  r.1 10
  sel.2 0
  c 15 0 7 7 0 0
; 20 STG.E [R4.64], R12
  stg.0 7 4
  stg.1 12 0
  stg.2 63 1 4 7 1 1
  c 2 1 7 4 0 0
; 21 LOP3.LUT R13, R10, 0xffff, RZ, 0xc0   x & 0xffff
  lop3.i.0 7 13 10
  n.1 0xffff
  lop3.2 255 0xc0
  c 15 0 7 7 0 0
; 22 I2F.U32 R13, R13   (float)
  i2f.0 7 13
  r.1 13
  i2f.2 0 2 0 2
  c 2 1 0 7 0 0
; 23 MOV R14, 0x40400000   3.0f
  mov.i.0 7 14
  n.1 0x40400000
  mov.2 15
  c 15 0 7 7 0 0
; 24 FFMA R13, R13, 0.5, R14   f * 0.5 + 3
  ffma.i.0 7 13 13
  n.1 0x3f000000
  ffma.2 14 0 0 0 0
  c 15 0 7 7 63 0
; 25 FMUL R13, R13, R13
  fmul.0 7 13 13
  r.1 13
  fmul.2 0 0 0 0
  c 15 0 7 7 0 0
; 26 F2I.U32.TRUNC R15, R13
  f2i.0 7 15
  r.1 13
  f2i.2 0 2 3 0 2
  c 2 1 1 7 0 0
; 27 STG.E [R6.64], R15
  stg.0 7 6
  stg.1 15 0
  stg.2 63 1 4 7 1 1
  c 2 1 7 5 63 0
; 28 EXIT   after every scoreboard
  exit.0 7
  z.1
  exit.2
  c 5 1 7 7 63 0
; 29 BRA to itself
  bra.0 7
  bra.1 0x0fffffff
  bra.2 -1 7
  c 0 0 7 7 0 0
